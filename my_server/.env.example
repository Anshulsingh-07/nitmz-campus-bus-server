# Shared API key required by ESP32 clients posting telemetry.
API_SECRET_KEY=replace_with_a_long_random_secret
# PostgreSQL hostname; use db when running the provided Docker Compose stack.
DB_HOST=your_postgres_host
# PostgreSQL port.
DB_PORT=5432
# PostgreSQL username.
DB_USER=your_postgres_user
# PostgreSQL password.
DB_PASSWORD=your_postgres_password
# PostgreSQL database name.
DB_NAME=campus_bus_tracker
# Enable TLS for hosted PostgreSQL providers.
DB_SSL=false
# Runtime mode; use production on Render.
NODE_ENV=development
