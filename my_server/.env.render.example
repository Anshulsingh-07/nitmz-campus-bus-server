# Shared key for ESP32 telemetry; generate a unique random value.
API_SECRET_KEY=replace_with_a_long_random_secret
# PostgreSQL connection details from your hosted database.
DB_HOST=your_postgres_host
DB_PORT=5432
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_NAME=postgres
DB_SSL=true
# Set to production on Render; local .env may use development.
NODE_ENV=production
